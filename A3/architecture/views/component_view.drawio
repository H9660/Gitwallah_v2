<mxfile host="gitcore"><diagram id="gitcore" name="GitCore component view"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1300" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;GitCore - issue in, reviewed PR out&lt;/b&gt; (fork H9660/Gitwallah_v2, .github/workflows/autose.yml)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="trig" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;label &lt;i&gt;autose&lt;/i&gt; or &lt;i&gt;/autose&lt;/i&gt; comment&lt;br&gt;(collaborators only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="170" height="70" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;gate job&lt;/b&gt; (code)&lt;br&gt;check sender permission,&lt;br&gt;concurrency per issue&lt;br&gt;&lt;i&gt;issues: write&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="85" width="170" height="80" as="geometry"/></mxCell><mxCell id="lane1" value="&lt;b&gt;build job&lt;/b&gt; - LangGraph StateGraph, routing by code, state.json after every node - &lt;i&gt;contents: read, no GitHub token&lt;/i&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="820" height="330" as="geometry"/></mxCell><mxCell id="spec" value="&lt;b&gt;&lt;u&gt;1 REQUIREMENTS&lt;/u&gt;&lt;/b&gt;&lt;br&gt;Spec agent (A1 skill)&lt;br&gt;spec.md / spec.json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="cs" value="check_spec (code)&lt;br&gt;ACs testable? safety flag?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="220" width="160" height="50" as="geometry"/></mxCell><mxCell id="des" value="&lt;b&gt;&lt;u&gt;2 DESIGN&lt;/u&gt;&lt;/b&gt;&lt;br&gt;Design agent&lt;br&gt;+ ARCHITECTURE.md&lt;br&gt;design.md / design.json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="105" width="160" height="80" as="geometry"/></mxCell><mxCell id="cd" value="check_design (code)&lt;br&gt;files + functions exist?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="160" height="50" as="geometry"/></mxCell><mxCell id="imp" value="&lt;b&gt;&lt;u&gt;3 IMPLEMENT&lt;/u&gt;&lt;/b&gt;&lt;br&gt;Implementer agent&lt;br&gt;diff.patch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="cb" value="check_build (code)&lt;br&gt;npm run build, allowed paths" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="160" height="50" as="geometry"/></mxCell><mxCell id="tst" value="&lt;b&gt;&lt;u&gt;4 TEST&lt;/u&gt;&lt;/b&gt;&lt;br&gt;Test agent (1 test per AC)&lt;br&gt;test_report.md" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="ct" value="check_tests (code)&lt;br&gt;npm test, AC coverage,&lt;br&gt;no tests removed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="215" width="170" height="60" as="geometry"/></mxCell><mxCell id="clar" value="needs clarification /&lt;br&gt;unsafe: comment questions, stop" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="310" width="180" height="55" as="geometry"/></mxCell><mxCell id="rel" value="&lt;b&gt;&lt;u&gt;5 RELEASE&lt;/u&gt;&lt;/b&gt; (code)&lt;br&gt;git push autose/issue-N&lt;br&gt;gh pr create / edit&lt;br&gt;&lt;i&gt;contents+PR write&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="170" height="80" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;ci job&lt;/b&gt;&lt;br&gt;reusable ci.yml&lt;br&gt;build + tests" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="150" height="60" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;&lt;u&gt;6 REVIEW&lt;/u&gt;&lt;/b&gt; - review job&lt;br&gt;Reviewer agent: other model,&lt;br&gt;issue + diff + repo only,&lt;br&gt;read + run, no write" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="440" width="200" height="80" as="geometry"/></mxCell><mxCell id="post" value="post step (code)&lt;br&gt;PR comment review.md&lt;br&gt;label approved / changes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="420" y="450" width="180" height="60" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;fix job&lt;/b&gt; (round 1 only)&lt;br&gt;re-enter